{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": false,
    "removeComments": false,
    "jsx": "react",
    "baseUrl": ".",
    "paths": {
      "@ns": ["types/NetscriptDefinitions.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "types/**/*.d.ts"]
}
